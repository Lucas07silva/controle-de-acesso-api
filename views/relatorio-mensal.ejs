<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> - <%= relatorio.mes %></title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 28px; color: #172033; font: 13px Arial, Helvetica, sans-serif; }
        .sheet { max-width: 1100px; margin: 0 auto; }
        .actions { display: flex; justify-content: flex-end; margin-bottom: 20px; }
        button { padding: 10px 16px; border: 0; border-radius: 6px; background: #1d4ed8; color: #fff; font-weight: 700; cursor: pointer; }
        h1 { margin: 0 0 7px; font-size: 25px; }
        .muted { color: #68748a; }
        .summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 24px 0; }
        .metric { padding: 14px; border: 1px solid #dce2eb; border-radius: 8px; }
        .metric span { display: block; color: #68748a; font-size: 11px; }
        .metric strong { display: block; margin-top: 7px; font-size: 22px; }
        h2 { margin: 27px 0 10px; font-size: 17px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 8px 9px; border: 1px solid #dce2eb; text-align: left; }
        th { background: #f2f5f9; }
        .footer { margin-top: 24px; padding-top: 12px; border-top: 1px solid #dce2eb; color: #68748a; font-size: 10px; }
        @media print {
            body { padding: 0; }
            .actions { display: none; }
            .sheet { max-width: none; }
            tr { break-inside: avoid; }
            thead { display: table-header-group; }
        }
        @media (max-width: 700px) {
            body { padding: 14px; }
            .summary { grid-template-columns: repeat(2, 1fr); }
            .table-scroll { overflow-x: auto; }
            table { min-width: 650px; }
        }
    </style>
</head>
<body>
    <main class="sheet">
        <div class="actions">
            <button type="button" onclick="window.print()">Imprimir / Salvar como PDF</button>
        </div>
        <header>
            <p class="muted">RÁDIO · CONTROLE DE ACESSO</p>
            <h1><%= titulo %></h1>
            <p class="muted">Período: <strong><%= relatorio.mes %></strong> · Gerado em <%= new Date().toLocaleString("pt-BR", { timeZone: "America/Bahia" }) %></p>
        </header>

        <section class="summary">
            <div class="metric"><span>Movimentações</span><strong><%= relatorio.resumo.totalMovimentacoes %></strong></div>
            <div class="metric"><span>Entradas liberadas</span><strong><%= relatorio.resumo.entradas %></strong></div>
            <div class="metric"><span>Saídas liberadas</span><strong><%= relatorio.resumo.saidas %></strong></div>
            <div class="metric"><span>Tentativas negadas</span><strong><%= relatorio.resumo.negados %></strong></div>
        </section>

        <h2>Movimentação por funcionário</h2>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Funcionário</th><th>ID</th><th>Entradas</th><th>Saídas</th><th>Negadas</th><th>Primeira movimentação</th><th>Última movimentação</th></tr></thead>
                <tbody>
                    <% if (relatorio.porFuncionario.length) { %>
                        <% relatorio.porFuncionario.forEach(funcionario => { %>
                            <tr>
                                <td><%= funcionario.nome %></td>
                                <td><%= funcionario.userId %></td>
                                <td><%= funcionario.entradas %></td>
                                <td><%= funcionario.saidas %></td>
                                <td><%= funcionario.negados %></td>
                                <td><%= new Date(funcionario.primeiraMovimentacao).toLocaleString("pt-BR", { timeZone: "America/Bahia" }) %></td>
                                <td><%= new Date(funcionario.ultimaMovimentacao).toLocaleString("pt-BR", { timeZone: "America/Bahia" }) %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7">Nenhuma movimentação encontrada no período.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <h2>Resumo por dia</h2>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Data</th><th>Movimentações</th><th>Entradas</th><th>Saídas</th><th>Negadas</th></tr></thead>
                <tbody>
                    <% if (relatorio.porDia.length) { %>
                        <% relatorio.porDia.forEach(dia => { %>
                            <tr><td><%= dia.data.split("-").reverse().join("/") %></td><td><%= dia.totalMovimentacoes %></td><td><%= dia.entradas %></td><td><%= dia.saidas %></td><td><%= dia.negados %></td></tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5">Nenhum evento encontrado no período.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <p class="footer">Relatório calculado com base nos eventos AccessControl recebidos e armazenados pelo sistema. Status 1 ou ausente: sucesso; Status 0: tentativa negada. Horários no fuso America/Bahia.</p>
    </main>
</body>
</html>
