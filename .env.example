# CONFIGURACAO DE EXEMPLO - copie para .env e ajuste ao seu ambiente.
# Nunca publique .env, credenciais, certificados ou fotografias.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=controle_acesso_radio

# Localidade para estimativas meteorologicas historicas (opcional).
# Sem latitude/longitude configuradas, o modulo meteorologico informa indisponibilidade.
CLIMA_LATITUDE=
CLIMA_LONGITUDE=
CLIMA_LOCALIDADE=Localidade configurada na implantacao
CLIMA_TIMEZONE=America/Sao_Paulo

# Integracao administrativa de saida: Node.js -> terminal (HTTPS + Digest).
INTELBRAS_DEVICE_URL=
INTELBRAS_DEVICE_USER=
INTELBRAS_DEVICE_PASSWORD=
INTELBRAS_DEVICE_SERIAL=
INTELBRAS_TIMEOUT_MS=12000
INTELBRAS_CA_PATH=

# Webhook de entrada: terminal -> Node.js.
# Informe os IPs realmente observados no log do servidor, separados por virgula.
INTELBRAS_WEBHOOK_IPS=
INTELBRAS_WEBHOOK_MAX_BYTES=12mb

# Conta administrativa independente das credenciais do terminal.
BIOMETRIA_ADMIN_USER=
BIOMETRIA_ADMIN_PASSWORD=
BIOMETRIA_SESSION_SECRET=

# Fotografias de ocorrencias: armazenamento privado e retencao.
BIOMETRIA_STORAGE_DIR=./storage/ocorrencias-face
BIOMETRIA_RETENCAO_DIAS=30
BIOMETRIA_FOTO_MAX_BASE64_CHARS=200000

# HTTPS de entrada para area administrativa e webhook com fotografias.
HTTPS_PORT=3443
HTTPS_PFX_PATH=
HTTPS_PFX_PASSPHRASE=
# Alternativa PEM; use PFX ou o par PEM.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
TRUST_PROXY=0
